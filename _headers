# 适用于所有路径的全局响应头
/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
  Access-Control-Allow-Origin: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: unsafe-none
  X-Download-Options: noopen
  X-Permitted-Cross-Domain-Policies: none
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-+0/fEwiuUBP5vcf8hum4eWIuyiAF+9KsqLUG+e7jD6c='; style-src 'self' 'sha256-sFb8KYPVjqQzykPwEvpngfA8Tfge/s0DmyxnZUStEug='; img-src 'self' data:; font-src 'self'; connect-src 'self' https://stats.uptimerobot.com; frame-ancestors 'none'