# 适用于所有路径的全局响应头
/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
  Access-Control-Allow-Origin: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: unsafe-none
  X-Download-Options: noopen
  X-Permitted-Cross-Domain-Policies: none
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-DBTBucZlPcXfAPi3jKRP7wvssuNd+7ODvgCtp7HbN/4='; style-src 'self' 'sha256-WNN6yysvm4CDQgYa1l1tMAH+YRUvDZ3d8IVo4f8KMyQ='; img-src 'self' data:; font-src 'self'; connect-src 'self' https://stats.uptimerobot.com; frame-ancestors 'none'